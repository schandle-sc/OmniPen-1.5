<Window x:Class="OmniPen.Views.HandwritingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chuyển chữ viết tay thành văn bản"
        Icon="/Assets/OmniPen.ico"
        Width="620" Height="470" WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="16">
        <TextBlock x:Name="InfoText" DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Kiểu chữ:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" />
                <RadioButton x:Name="HandFont" Content="Chữ viết tay" Margin="0,0,16,0" VerticalAlignment="Center" Checked="Font_Changed" />
                <RadioButton x:Name="TypeFont" Content="Chữ đánh máy" IsChecked="True" VerticalAlignment="Center" Checked="Font_Changed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Thay nét viết bằng chữ" Padding="14,6" IsDefault="True" Margin="0,0,8,0" Click="Replace_Click" FontWeight="SemiBold" />
                <Button Content="Chèn thêm (giữ nét viết)" Padding="14,6" Margin="0,0,8,0" Click="Insert_Click" />
                <Button Content="Hủy" Width="80" IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Text="Kết quả nhận dạng (sửa lại nếu cần):" Margin="0,0,0,4" />
        <TextBox x:Name="ResultBox" AcceptsReturn="True" TextWrapping="Wrap" FontSize="20" VerticalScrollBarVisibility="Auto" Padding="6" />
    </DockPanel>
</Window>
