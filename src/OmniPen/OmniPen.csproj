<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- windows10.0.19041.0: mở khóa API WinRT có sẵn trong Windows (Windows.Data.Pdf để render PDF,
         Windows.Media.Capture để chụp camera). Vẫn chạy trên Windows 10 1809 trở lên. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>OmniPen</RootNamespace>
    <AssemblyName>OmniPen</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>

    <!-- WPF cho UI + WinForms cho Screen (đa màn hình), NotifyIcon (khay hệ thống), ColorDialog. -->
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>

    <!-- Per-Monitor V2 DPI awareness – bắt buộc cho logic đa màn hình (xem app.manifest). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\OmniPen.ico</ApplicationIcon>

    <!-- ===== Thông tin phiên bản (hiện trong Properties > Details của file exe và trong cửa sổ Giới thiệu) ===== -->
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <InformationalVersion>1.5</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>OmniPen</Product>
    <AssemblyTitle>OmniPen - Viết bảng điện tử</AssemblyTitle>
    <Description>OmniPen - Viết bảng điện tử &amp; chú thích màn hình</Description>
    <Authors>Hồ Văn Thuyên</Authors>
    <Company>Trường THPT Hoàng Hoa Thám</Company>
    <Copyright>© 2026 Hồ Văn Thuyên - Trường THPT Hoàng Hoa Thám</Copyright>
    <NeutralLanguage>vi-VN</NeutralLanguage>
    <!-- WFAC010: WinForms gợi ý khai báo DPI qua Application.SetHighDpiMode – không áp dụng cho app WPF (đã khai báo trong app.manifest). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>

    <!-- Chỉ giữ tài nguyên ngôn ngữ cần thiết → exe nhỏ hơn. -->
    <SatelliteResourceLanguages>vi;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Cấu hình khi publish (build.ps1 truyền -r win-x64 / win-x86).
       Chỉ áp dụng khi có RuntimeIdentifier: self-contained/single-file bắt buộc phải có RID,
       nên "dotnet build -c Release" thông thường (không -r) vẫn chạy được. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <DebugType>none</DebugType>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- WPF KHÔNG hỗ trợ trimming: tắt rõ ràng để tránh lỗi runtime khó đoán. -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bật cả WPF và WinForms sẽ trùng tên (Application, Brush, Color, MessageBox…).
         Gỡ global using của WinForms/Drawing; khi cần thì dùng alias tường minh. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\OmniPen.ico" />
    <Resource Include="Assets\Logo256.png" />
    <Resource Include="Assets\DonateQR.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phiên bản nằm ở Directory.Packages.props (Central Package Management). -->
    <PackageReference Include="PdfPig" />
  </ItemGroup>

</Project>
