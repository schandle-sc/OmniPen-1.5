<Window x:Class="OmniPen.Views.SnipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniPen – Chụp vùng chọn"
        WindowStyle="None" AllowsTransparency="False" Background="Black"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Cursor="Cross">
    <!-- Ảnh "đóng băng" toàn màn hình + lớp tối; vùng đang kéo được khoét sáng. -->
    <Grid x:Name="Root">
        <Image x:Name="Frozen" Stretch="Fill" />
        <Path x:Name="Dim" Fill="#99000000" />
        <Canvas>
            <Rectangle x:Name="SelRect" Stroke="#FF4FACFE" StrokeThickness="2" Visibility="Collapsed" />
            <Border x:Name="SizeLabel" Background="#E60F172A" CornerRadius="4" Padding="6,2" Visibility="Collapsed">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
            </Border>
        </Canvas>
        <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" Background="#E60F172A" CornerRadius="10" Padding="16,8">
            <TextBlock Foreground="White" FontSize="15" Text="Kéo chuột để chọn vùng chụp  ·  Enter: chụp toàn màn hình  ·  Esc: hủy" />
        </Border>
    </Grid>
</Window>
