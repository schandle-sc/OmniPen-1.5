<Project>
  <!--
    Central Package Management (CPM): MỌI phiên bản thư viện NuGet khai báo tập trung ở đây,
    file .csproj chỉ ghi tên gói (không ghi phiên bản).
    Cập nhật: sửa phiên bản tại đây rồi chạy lệnh "dotnet restore".
    Kiểm tra lỗ hổng / lỗi thời: lệnh "dotnet list package" với tùy chọn vulnerable hoặc outdated.
    LƯU Ý: chú thích XML không được chứa hai dấu gạch ngang liền nhau.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="PDF">
    <!-- Đọc chữ + vị trí từng từ trong PDF (Apache-2.0). Render trang dùng Windows.Data.Pdf có sẵn trong Windows. -->
    <PackageVersion Include="PdfPig" Version="0.1.11" />
  </ItemGroup>
</Project>
