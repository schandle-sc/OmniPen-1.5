<Window x:Class="OmniPen.Views.CameraWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chụp ảnh từ camera"
        Icon="/Assets/OmniPen.ico"
        Width="760" Height="620"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Camera:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <CheckBox x:Name="MirrorCheck" DockPanel.Dock="Right" Content="Lật ngang (gương)" VerticalAlignment="Center"
                      Margin="12,0,0,0" Checked="Mirror_Changed" Unchecked="Mirror_Changed" />
            <ComboBox x:Name="CameraCombo" Height="28" SelectionChanged="CameraCombo_SelectionChanged" />
        </DockPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCapture" Content="📷  Chụp" Width="120" Height="32" Margin="0,0,8,0" IsDefault="True" Click="BtnCapture_Click" />
            <Button x:Name="BtnRetake" Content="Chụp lại" Width="100" Height="32" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnRetake_Click" />
            <Button x:Name="BtnInsert" Content="Chèn vào trang" Width="130" Height="32" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnInsert_Click" />
            <Button Content="Hủy" Width="90" Height="32" IsCancel="True" />
        </StackPanel>

        <Border Background="Black" CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="MirrorTransform" ScaleX="1" />
                    </Image.RenderTransform>
                </Image>
                <TextBlock x:Name="StatusText" Text="Đang mở camera…" Foreground="White" FontSize="15"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="30"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DockPanel>
</Window>
