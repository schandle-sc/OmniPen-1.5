<Window x:Class="OmniPen.Views.PlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hệ trục Oxy &amp; Vẽ đồ thị"
        Icon="/Assets/OmniPen.ico"
        Width="980" Height="640" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="#FFF8FAFC">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel>
            <TextBlock Text="Hàm số (để trống = chỉ vẽ hệ trục Oxy)" FontWeight="SemiBold" Margin="0,0,0,6" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Ellipse Width="14" Height="14" Fill="#FF2563EB" Margin="0,0,8,0" />
                <TextBox x:Name="F1" Grid.Column="1" Height="30" FontFamily="Consolas" FontSize="15" VerticalContentAlignment="Center" Text="y = x^2 - 4x + 3" TextChanged="Input_Changed" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Ellipse Width="14" Height="14" Fill="#FFDC2626" Margin="0,0,8,0" />
                <TextBox x:Name="F2" Grid.Column="1" Height="30" FontFamily="Consolas" FontSize="15" VerticalContentAlignment="Center" TextChanged="Input_Changed" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Ellipse Width="14" Height="14" Fill="#FF16A34A" Margin="0,0,8,0" />
                <TextBox x:Name="F3" Grid.Column="1" Height="30" FontFamily="Consolas" FontSize="15" VerticalContentAlignment="Center" TextChanged="Input_Changed" />
            </Grid>

            <TextBlock Text="Mẫu nhanh (bấm để đưa vào ô trống):" Foreground="#555" Margin="0,4,0,4" />
            <WrapPanel x:Name="SamplePanel" Margin="0,0,0,8" />

            <TextBlock Text="Khoảng hiển thị" FontWeight="SemiBold" Margin="0,6,0,6" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                <TextBlock Text="x từ" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="XMin" Grid.Column="1" Text="-6" Height="26" Margin="0,2" TextChanged="Input_Changed" />
                <TextBlock Grid.Column="2" Text="  đến" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="XMax" Grid.Column="3" Text="6" Height="26" Margin="0,2" TextChanged="Input_Changed" />
                <TextBlock Grid.Row="1" Text="y từ" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="YMin" Grid.Row="1" Grid.Column="1" Text="-4" Height="26" Margin="0,2" TextChanged="Input_Changed" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="  đến" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="YMax" Grid.Row="1" Grid.Column="3" Text="4" Height="26" Margin="0,2" TextChanged="Input_Changed" />
            </Grid>
            <CheckBox x:Name="AutoY" Content="Tự chọn khoảng y vừa đồ thị" IsChecked="True" Margin="0,6,0,0" Click="Input_Changed" />
            <CheckBox x:Name="GridCheck" Content="Hiện lưới ô vuông" IsChecked="True" Margin="0,6,0,0" Click="Input_Changed" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Kích thước:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="SizeCombo" Width="150" SelectedIndex="1" SelectionChanged="Input_Changed">
                    <ComboBoxItem Content="Nhỏ (480 × 340)" />
                    <ComboBoxItem Content="Vừa (640 × 440)" />
                    <ComboBoxItem Content="Lớn (860 × 580)" />
                </ComboBox>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,10,0,0" />
            <TextBlock Foreground="#64748B" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12"
                       Text="Hỗ trợ: + − * / ^, sin cos tan cot sqrt √ abs |x| ln log exp, pi π, e; viết tắt 2x, x², sin 2x." />
        </StackPanel>

        <DockPanel Grid.Column="1" Margin="18,0,0,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Vẽ lên trang" Width="130" Height="34" IsDefault="True" Margin="0,0,8,0" Click="Insert_Click" FontWeight="SemiBold" />
                <Button Content="Hủy" Width="90" Height="34" IsCancel="True" />
            </StackPanel>
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="White" Padding="8">
                <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
        </DockPanel>
    </Grid>
</Window>
