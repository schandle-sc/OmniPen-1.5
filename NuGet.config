<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Chỉ dùng nuget.org – build giống nhau trên mọi máy, không phụ thuộc nguồn gói cấu hình riêng của từng máy. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
