<Window x:Class="OmniPen.Views.EffectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniPen Effects"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" IsHitTestVisible="False" Focusable="False">
    <!--
        Lớp hiệu ứng trong suốt, LUÔN xuyên chuột (WS_EX_TRANSPARENT), phủ toàn desktop ảo:
          FocusDim    : làm tối mọi thứ trừ cửa sổ đang trỏ (Khung focus)
          RippleLayer : vòng gợn sóng khi click chuột
          KeyBubble   : bong bóng hiển thị tổ hợp phím ở cạnh dưới màn hình
    -->
    <Canvas x:Name="Root">
        <Path x:Name="FocusDim" Fill="#B3000000" Visibility="Collapsed" />
        <Rectangle x:Name="FocusFrame" Stroke="#FF4FACFE" StrokeThickness="3" RadiusX="8" RadiusY="8" Visibility="Collapsed" />
        <Canvas x:Name="RippleLayer" />
        <StackPanel x:Name="KeyStack" Orientation="Vertical" />
    </Canvas>
</Window>
