<Window x:Class="OmniPen.Views.FloatingButtonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OmniPen"
        Width="64" Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ToolTip="OmniPen – bấm để mở thanh công cụ, kéo để di chuyển">
    <!-- Nút tròn nhỏ hiện ở góc màn hình khi thanh công cụ đang ẩn. -->
    <Grid Margin="6" Cursor="Hand">
        <Ellipse Fill="#EE0F172A" Stroke="#664FACFE" StrokeThickness="1.5">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.5" />
            </Ellipse.Effect>
        </Ellipse>
        <Image Source="/Assets/Logo256.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
        <Ellipse x:Name="HoverRing" Stroke="#FF4FC3F7" StrokeThickness="2" Visibility="Collapsed" />
    </Grid>
</Window>
