<Window x:Class="OmniPen.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giới thiệu OmniPen"
        Icon="/Assets/OmniPen.ico"
        Width="760" Height="720" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FFF8FAFC"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <LinearGradientBrush x:Key="InkGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF00F2FE" Offset="0" />
            <GradientStop Color="#FF4FACFE" Offset="0.5" />
            <GradientStop Color="#FFB066FE" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{StaticResource InkGradient}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Đầu trang: logo + tên + phiên bản ===== -->
        <Border DockPanel.Dock="Top" Background="#FF0F172A" Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="/Assets/Logo256.png" Width="96" Height="96" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TitleText" Text="OmniPen" FontSize="32" FontWeight="Bold" Foreground="{StaticResource InkGradient}" />
                        <Border Background="#334FACFE" CornerRadius="10" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionText" Text="1.4" Foreground="#FF8FD3FE" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DescriptionText" Foreground="#FFCBD5E1" FontSize="15" Margin="0,2,0,0" />
                    <TextBlock x:Name="TaglineText" Foreground="#FF94A3B8" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="19" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Chân trang: nút ===== -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#FFE2E8F0" BorderThickness="0,1,0,0" Padding="24,12">
            <DockPanel>
                <TextBlock x:Name="CopyrightText" Foreground="#FF64748B" VerticalAlignment="Center" FontSize="12" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="♥  Ủng hộ tác giả" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="Donate_Click" />
                    <Button Content="Đóng" Width="96" Height="34" IsDefault="True" IsCancel="True" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel>
                <!-- ===== Tác giả & ủng hộ ===== -->
                <Border Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="10" Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TÁC GIẢ" Foreground="#FF64748B" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="AuthorText" FontSize="18" FontWeight="SemiBold" Foreground="#FF0F172A" Margin="0,2,0,0" />
                            <TextBlock x:Name="SchoolText" Foreground="#FF334155" />
                            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FF334155" LineHeight="19">
                                OmniPen được phát triển miễn phí cho thầy cô và học sinh. Nếu phần mềm hữu ích,
                                mời bạn ủng hộ tác giả để có thêm nhiều tính năng mới:
                                <Hyperlink x:Name="DonateLink" Click="Donate_Click" Foreground="#FF2563EB">
                                    <Run x:Name="DonateRun" Text="www.giaoducso.org" FontWeight="SemiBold" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Border Background="White" BorderBrush="#FFF9A8D4" BorderThickness="2" CornerRadius="10" Padding="4"
                                    Cursor="Hand" MouseLeftButtonUp="Qr_Click" ToolTip="Bấm để phóng to mã QR">
                                <Image Source="/Assets/DonateQR.png" Width="120" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <Button Content="♥  Ủng hộ" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0" Click="Donate_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Tổng quan tính năng ===== -->
                <TextBlock Text="Tính năng nổi bật" FontSize="17" FontWeight="SemiBold" Foreground="#FF0F172A" Margin="0,22,0,10" />
                <ItemsControl x:Name="FeatureList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- ===== Phím tắt ===== -->
                <TextBlock Text="Phím tắt" FontSize="17" FontWeight="SemiBold" Foreground="#FF0F172A" Margin="0,18,0,8" />
                <Border Background="White" BorderBrush="#FFE2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,12">
                    <TextBlock x:Name="ShortcutText" Foreground="#FF334155" TextWrapping="Wrap" LineHeight="21" FontFamily="Segoe UI" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
