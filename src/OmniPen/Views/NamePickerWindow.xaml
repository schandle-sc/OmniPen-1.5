<Window x:Class="OmniPen.Views.NamePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vòng quay gọi tên"
        Icon="/Assets/OmniPen.ico"
        Width="860" Height="560" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        Background="#FF0F172A" FontFamily="Segoe UI">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="260" />
        </Grid.ColumnDefinitions>

        <!-- Vòng quay -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Viewbox>
                <Grid Width="420" Height="440">
                    <Canvas x:Name="Wheel" Width="400" Height="400" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform>
                            <RotateTransform x:Name="WheelRotate" />
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Ellipse Width="70" Height="70" Fill="#FF0F172A" Stroke="White" StrokeThickness="4" VerticalAlignment="Bottom" Margin="0,0,0,165" />
                    <!-- Kim chỉ ở đỉnh -->
                    <Path Data="M 0,0 L 28,0 L 14,34 Z" Fill="#FFEF4444" Stroke="White" StrokeThickness="2"
                          HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0" />
                </Grid>
            </Viewbox>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock x:Name="ResultText" Text="Bấm QUAY để gọi tên" Foreground="White" FontSize="30" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <Button x:Name="BtnSpin" Content="🎯  QUAY" FontSize="18" FontWeight="SemiBold" Padding="34,8" Margin="0,10,0,0"
                        HorizontalAlignment="Center" Click="Spin_Click" Cursor="Hand" IsDefault="True" />
            </StackPanel>
        </Grid>

        <!-- Danh sách -->
        <DockPanel Grid.Column="1" Margin="18,0,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Danh sách (mỗi dòng một tên)" Foreground="#CBD5E1" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <CheckBox x:Name="RemoveCheck" Content="Bỏ tên đã gọi khỏi vòng quay" Foreground="#CBD5E1" IsChecked="True" />
                <TextBlock x:Name="CountText" Foreground="#94A3B8" Margin="0,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Cập nhật vòng quay" Padding="10,4" Click="Apply_Click" Margin="0,0,6,0" />
                    <Button Content="Khôi phục tên đã gọi" Padding="10,4" Click="Restore_Click" />
                </StackPanel>
            </StackPanel>
            <TextBox x:Name="NamesBox" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="14"
                     Background="#FF1E293B" Foreground="White" BorderBrush="#FF334155" Padding="6" />
        </DockPanel>
    </Grid>
</Window>
