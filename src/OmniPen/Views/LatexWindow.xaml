<Window x:Class="OmniPen.Views.LatexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chèn công thức LaTeX"
        Icon="/Assets/OmniPen.ico"
        Width="680" Height="560"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="16">
        <!-- Thông báo khi chưa cài LaTeX -->
        <Border x:Name="MissingPanel" DockPanel.Dock="Top" Visibility="Collapsed" Background="#FFFFF4E5"
                BorderBrush="#FFFFB74D" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap">
                    Chưa tìm thấy bộ LaTeX trên máy (cần <Run FontWeight="SemiBold">latex.exe</Run> và
                    <Run FontWeight="SemiBold">dvipng.exe</Run>). Hãy cài MiKTeX (miễn phí), khởi động lại OmniPen,
                    hoặc chỉ ra thư mục chứa hai file trên.
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Tải MiKTeX…" Padding="12,4" Margin="0,0,8,0" Click="Download_Click" />
                    <Button Content="Chọn thư mục LaTeX…" Padding="12,4" Click="Browse_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="Công thức (cú pháp LaTeX, không cần gõ $…$):" Margin="0,0,0,6" />

        <!-- Mẫu nhanh -->
        <WrapPanel x:Name="SamplePanel" DockPanel.Dock="Top" Margin="0,0,0,6" />

        <TextBox x:Name="FormulaBox" DockPanel.Dock="Top" Height="90" AcceptsReturn="True" TextWrapping="Wrap"
                 FontFamily="Consolas" FontSize="15" VerticalScrollBarVisibility="Auto"
                 Text="x = \frac{-b \pm \sqrt{b^2 - 4ac}}{2a}" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnPreview" Content="Xem trước" Width="110" Height="32" Margin="0,0,8,0" Click="Preview_Click" />
            <Button x:Name="BtnInsert" Content="Chèn vào trang" Width="130" Height="32" Margin="0,0,8,0" IsDefault="True" Click="Insert_Click" />
            <Button Content="Hủy" Width="90" Height="32" IsCancel="True" />
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Foreground="#B00020" TextWrapping="Wrap" Margin="0,8,0,0"
                   FontFamily="Consolas" />

        <Border Margin="0,10,0,0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6" Background="White">
            <Image x:Name="PreviewImage" Stretch="Uniform" StretchDirection="DownOnly" Margin="12" />
        </Border>
    </DockPanel>
</Window>
